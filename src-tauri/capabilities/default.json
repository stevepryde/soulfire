{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "default",
  "description": "Default capability for the main Soulfire window.",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "allow-store-lifecycle",
    "allow-profile-settings",
    "allow-credentials",
    "allow-builders",
    "allow-images",
    "allow-prompts",
    "allow-stats",
    "allow-content",
    "allow-chat",
    "allow-adventure"
  ]
}
